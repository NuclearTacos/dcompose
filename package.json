{
  "name": "@chrisrea/dcompose",
  "version": "0.1.0",
  "description": "Compose MCP tool calls in code. Code Mode for shell-driven agents.",
  "type": "module",
  "bin": {
    "dcompose": "./bin/dcompose.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^22.20.2",
    "commander": "^15.0.0",
    "json-schema-to-typescript": "^16.0.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
