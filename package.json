{
  "name": "dcompose",
  "version": "0.1.0",
  "description": "Code Mode for the shell: compose MCP tool calls in TypeScript scripts so only the answer reaches the agent",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "agent",
    "code-mode",
    "cli",
    "typescript",
    "llm",
    "tools"
  ],
  "author": "Chris Rea",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NuclearTacos/dcompose.git"
  },
  "homepage": "https://github.com/NuclearTacos/dcompose#readme",
  "bugs": {
    "url": "https://github.com/NuclearTacos/dcompose/issues"
  },
  "type": "module",
  "bin": {
    "dcompose": "./bin/dcompose.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:watch": "node --test --watch \"test/**/*.test.ts\"",
    "lint": "eslint src test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^22.20.2",
    "commander": "^15.0.0",
    "json-schema-to-typescript": "^16.0.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
